# environments and dependencies
.venv/
node_modules/
__pycache__/
*.pyc
# Blender autosave copies
*.blend1
# build / test outputs
web/dist/
web/test-results/
web/playwright-report/
web/public/bundles/*.json
# scenario cubes are copied from data/cubes/ by sync-bundles
web/public/cubes/
!web/public/bundles/demo-fixture.json
# large upstream NASA rasters (re-download: see docs/DATA_PROVENANCE.md); SHA-256 recorded in the bundles
app/data/source/**/*.tif
# release zips
dist/*.zip
.DS_Store

# scratch output from other tools
tmp/

# PGDA 69 / 78 downloads for tools/pgda69 (re-fetched with pinned SHA-256)
data/raw/pgda69/
# reproducible NASA/JPL science cache; source URLs and hashes live in bundles
data/cache/
# standalone solver API cache (NASA rasters + raw Horizons responses)
data/external/

# LROC NAC visual windows: keep the 8-bit PNG + manifest, not the float32 copy or partial downloads
data/visual/**/*_f32.tif
data/visual/**/*.partial
data/visual/**/*.rows

# Derived NASA raster/mesh products for the 3D view (rebuilt by tools/terrain/build_terrain_context.py,
# NASA SVS globe GLB, LROC NAC crops). Not committed: NASA rasters stay out of git.
web/public/context/**/*.bin
data/visual/terrain_context/**/*.bin
web/public/globe/*.glb
app/assets/nasa/*.glb
web/public/visual/site01_center_2km_1m_8bit.png
data/visual/lroc_nac_pole_south_cm_avg/*.png
blender/output/
app/dist/

# 5D Phase 9.4 near-field LOD tiles (NASA PGDA 78 derived; rebuilt by tools/terrain/build_lod_tiles.py). Not committed.
web/public/context/lod/

# v2 S3 web layers derived from NASA rasters (rebuilt by tools/globe/coverage.py, seams.py, analytics.py). Not committed.
web/public/globe/coverage/
web/public/globe/qa/
web/public/globe/analytics/

# v2 R2 Cesium quantized-mesh display terrain (built from the NASA-derived pyramid by tools/globe/qmesh.py). Not committed.
web/public/globe/terrain/

# v2 T1 exports (GeoTIFF masks/maps are NASA-derived; PDF/CSV/JSON are rebuilt by python -m science.exports). Not committed.
data/exports/
# v2 T1 gate screenshots of the 3D views (NASA-derived terrain render; regenerated by the gate)
docs/v2/gates/mobile-390-explore*.png
