# environments and dependencies
.venv/
node_modules/
__pycache__/
*.pyc
# Blender autosave copies
*.blend1
# build / test outputs
web/dist/
web/test-results/
web/playwright-report/
web/public/bundles/*.json
!web/public/bundles/demo-fixture.json
# large upstream NASA rasters (re-download: see docs/DATA_PROVENANCE.md); SHA-256 recorded in the bundles
app/data/source/**/*.tif
# release zips
dist/*.zip
.DS_Store

# scratch output from other tools
tmp/

# PGDA 69 / 78 downloads for tools/pgda69 (re-fetched with pinned SHA-256)
data/raw/pgda69/
# reproducible NASA/JPL science cache; source URLs and hashes live in bundles
data/cache/
# standalone solver API cache (NASA rasters + raw Horizons responses)
data/external/

# LROC NAC visual windows: keep the 8-bit PNG + manifest, not the float32 copy or partial downloads
data/visual/**/*_f32.tif
data/visual/**/*.partial
data/visual/**/*.rows

# Derived NASA raster/mesh products for the 3D view (rebuilt by tools/terrain/build_terrain_context.py,
# NASA SVS globe GLB, LROC NAC crops). Not committed: NASA rasters stay out of git.
web/public/context/**/*.bin
data/visual/terrain_context/**/*.bin
# (web/public/globe: only NASA_SVS_moon_small.glb, 13.8 MB, is force-tracked so a clean clone draws the globe. The 8k model
# NASA_SVS_Moon_NASA_LRO_8k_Topo_Small.glb is 81.5 MB, over the 50 MB kept in git, and moon_lite.glb is rebuilt by
# web/scripts/make_globe_lite.mjs; both stay local.)
web/public/globe/*.glb
app/assets/nasa/*.glb
web/public/visual/site01_center_2km_1m_8bit.png
data/visual/lroc_nac_pole_south_cm_avg/*.png
blender/output/
app/dist/
