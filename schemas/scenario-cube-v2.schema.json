{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris-x.local/schemas/scenario-cube-v2.schema.json",
  "title": "POLARIS X scenario cube v2 (6D roles)",
  "description": "scenario-cube-v1 plus a required `role` on every axis: uncertainty (X, what we don't control; stress over it), decision (L, what the mission controls; optimise over it), requirement (a filter on outcomes, never an axis to optimise or stress), context (a selector such as site, world, time coordinate or measure; neither stressed nor optimised). `kind` is kept unchanged. Values, flat indexing, missing mask and derived blocks are exactly as in v1. Scenario axes are deterministic cases, never a spatial dimension and never a probability. See docs/v2/6D_MODEL.md and docs/SCENARIO_CUBE_CONTRACT.md.",
  "x-role-rule": "role = x-role-by-kind[kind], unless (kind, name) is listed in x-role-overrides. Deterministic; see science/cube/v2.py and web/src/bundle/scenarioCubeV2.ts.",
  "x-role-by-kind": {
    "uncertainty_terrain": "uncertainty",
    "uncertainty_model": "uncertainty",
    "design": "decision",
    "schedule": "decision",
    "requirement": "requirement",
    "site": "context",
    "target": "context"
  },
  "x-role-overrides": [
    {
      "kind": "schedule",
      "name": "H",
      "role": "context",
      "reason": "hourly sample time coordinate (axis 4 itself), not a start date the mission chooses"
    },
    {
      "kind": "schedule",
      "name": "S_window",
      "role": "context",
      "reason": "evaluation horizon (14-day demo window vs 12 months), a question selector, not a lever"
    },
    {
      "kind": "uncertainty_terrain",
      "name": "k",
      "role": "context",
      "reason": "outcome bin (number of clone maps passing), a measure, not a member of the uncertainty set X"
    }
  ],
  "type": "object",
  "required": [
    "schema",
    "cube_id",
    "site_id",
    "label",
    "generated_utc",
    "dims",
    "metrics",
    "missing",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "scenario-cube-v2"
    },
    "cube_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "generated_utc": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fixed": {
      "description": "Axes held constant for every cell of this cube (e.g. mast height, visibility rule).",
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "dims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dim"
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "missing": {
      "description": "Explicit missing mask per metric: sparse flat (row-major) indices. Missing cells hold null in values; nothing is filled silently.",
      "type": "object",
      "required": [
        "encoding",
        "by_metric"
      ],
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "const": "sparse-flat-index"
        },
        "by_metric": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "derived": {
      "description": "Robust-decision outputs precomputed in Python (worst case and k of N over T, regret, decision-changes flags). Each is a small cube over a subset of the parent dims (or extra R dims).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/derived"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "world": {
      "description": "Context selector: the body this cube describes. Not an axis. Migration from v1 sets 'moon' (every v1 cube is lunar).",
      "type": "string",
      "enum": [
        "moon",
        "mercury",
        "mars"
      ]
    },
    "migration": {
      "description": "Present when the cube was produced by migrating a v1 file; to_v1() removes it.",
      "type": "object",
      "required": [
        "from_schema",
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "from_schema": {
          "const": "scenario-cube-v1"
        },
        "tool": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role_rule": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "uncertainty",
        "decision",
        "requirement",
        "context"
      ],
      "description": "uncertainty = X (exogenous, stress over it); decision = L (policy lever, optimise over it); requirement = filter on outcomes; context = selector."
    },
    "dim": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "role",
        "values",
        "units",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "uncertainty_terrain",
            "uncertainty_model",
            "design",
            "schedule",
            "requirement",
            "site",
            "target"
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "role_note": {
          "type": "string",
          "description": "Why this axis has a role other than the one its kind gives (see x-role-overrides)."
        },
        "values": {
          "type": "array",
          "minItems": 1
        },
        "value_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "nominal_index": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "units",
        "label",
        "dtype",
        "values",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "units": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dtype": {
          "enum": [
            "int32",
            "float64",
            "bool"
          ]
        },
        "scale": {
          "type": "number",
          "description": "display value = stored value x scale (e.g. visible-sample count x 100/337 = %)."
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "provenance": {
          "type": "string"
        }
      }
    },
    "derived": {
      "type": "object",
      "required": [
        "dims",
        "metrics",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "dims": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "name of a parent dim (same values)"
              },
              {
                "$ref": "#/$defs/dim"
              }
            ]
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "method": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "inputs",
        "command",
        "code_commit"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "url": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "command": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "solver": {
          "type": "string"
        }
      }
    }
  }
}
